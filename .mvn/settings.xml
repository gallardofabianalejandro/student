<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repositorio del ecosistema (GitHub Packages, privado). Maven resuelve el <parent> solo con repositorios del
  settings.xml, por eso este archivo es obligatorio (lo activa .mvn/maven.config). Sin secretos: usuario y token
  salen de las variables de entorno GH_PACKAGES_USER y GH_PACKAGES_TOKEN (token con permiso read:packages).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>github</id>
            <username>${env.GH_PACKAGES_USER}</username>
            <password>${env.GH_PACKAGES_TOKEN}</password>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>ecosistema</id>
            <repositories>
                <repository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/gallardofabianalejandro/spring-boot-ecosystem-4x</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>ecosistema</activeProfile>
    </activeProfiles>
</settings>
