{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Imagenes Docker fijas en TestcontainersConfig.java (Renovate no las ve en el codigo)",
      "managerFilePatterns": [
        "**/TestcontainersConfig.java"
      ],
      "matchStrings": [
        "parse\\(\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\"\\)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "org.testcontainers:**"
      ],
      "groupName": "testcontainers"
    },
    {
      "matchPackageNames": [
        "org.springframework.boot:**"
      ],
      "groupName": "spring-boot"
    }
  ],
  "minimumReleaseAge": "3 days",
  "kubernetes": {
    "managerFilePatterns": [
      "/^deployment/.+\\.ya?ml$/"
    ]
  }
}
